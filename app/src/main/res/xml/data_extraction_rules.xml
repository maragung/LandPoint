<?xml version="1.0" encoding="utf-8"?>
<!--
  Cloud backup is deliberately excluded, not included.

  These records are land ownership: corner coordinates and photographs of
  certificates. Copying them into someone's Google account is a decision that
  belongs to them, and it was previously happening by default. The in-app
  archive (Settings > Backup) is the supported way off the device, because the
  user picks where that file goes.

  Device transfer keeps everything: moving to a new phone is precisely the case
  where losing the data is the whole problem, and the copy never leaves the two
  devices involved.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="images" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
