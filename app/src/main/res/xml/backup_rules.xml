<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 9 to 11, where `dataExtractionRules` is not read yet. Those releases
  have no device-to-device transfer either, so excluding everything here means
  exactly one thing: nothing is uploaded. See data_extraction_rules.xml.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
